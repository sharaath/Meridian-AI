# Meridian AI Backend Environment Variables
# Copy to .env and fill in your credentials. NEVER commit .env to version control.

# Application
APP_NAME=Meridian AI
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change-this-to-a-long-random-secret-in-production
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://127.0.0.1:8081

# Database (Leave blank for local SQLite fallback during local dev; set PostgreSQL URI for Supabase/production)
DATABASE_URL=

# Supabase (Auth + PostgreSQL + Private Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=meridian-uploads

# AI Providers (Only configured providers will appear in the model selector)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Web Search Providers (Optional: Tavily or Serper; falls back to DuckDuckGo Instant/HTML if unset)
TAVILY_API_KEY=
SERPER_API_KEY=
ENABLE_PUBLIC_WEB_SEARCH_FALLBACK=true

# Tool Execution Engine (Phase 3)
MAX_TOOL_ITERATIONS=5
TOOL_TIMEOUT_SEARCH=10.0
TOOL_TIMEOUT_DOC=5.0
TOOL_TIMEOUT_PYTHON=5.0

# Limits & Quotas
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_MB=20
FREE_DAILY_MESSAGE_LIMIT=50
FREE_DAILY_TOKEN_LIMIT=100000

